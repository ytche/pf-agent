.java-version
*.swp
*.swo

# Java / Maven
target/
*.class
*.jar
*.war

# Temporary files
*.tmp
*.bak
# 评测集导出文档（供人工确认的临时 docx/pdf 产物）
*_供确认.docx
*_供确认.pdf

# Docker / 本地部署（SP6）
.env                        # compose 环境变量（模板见 .env.example，勿入库）
/data/                      # compose 卷映射的向量库数据（./data ↔ 容器 ~/.pf_agent）
