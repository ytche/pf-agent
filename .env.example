# ============================================================
# PF Agent 环境变量模板
# 用法：cp .env.example .env 后按需填写。仅 Docker Compose 启动时自动加载；
#       本地 mvn 开发请用 export（见 docs/DEPLOYMENT.md）。
# ⚠️ 含虚线的配置项 env 覆盖行为不一致（见 DEPLOYMENT 三个已知坑），
#    以 yml 或程序参数（--pf.xxx=yyy）为准。
# ============================================================

# ---------- LLM（必填） ----------
# DeepSeek Chat API key（application.yml 中 ${DEEPSEEK_PF_API:...} 占位）
DEEPSEEK_PF_API=

# ---------- 查询 embedding 通道（默认 ollama，本地自部署零配置） ----------
# 主通道：ollama（默认，需本地/同网 Ollama bge-m3）| cloud（托管 bge-m3）
# PF_EMBEDDING_PRIMARY=ollama

# 主通道失败降级另一通道：
#   primary=cloud 时建议 true（自动兜底本地 ollama）；
#   注意 application.yml 显式写了 fallback-enabled: false，
#   要 cloud 主默认兜底须把下面设为 true（见 DEPLOYMENT 已知坑 ②）。
# PF_EMBEDDING_FALLBACK_ENABLED=false

# 托管 bge-m3 API key（仅当 primary=cloud 或启用 fallback 时使用；只经环境变量注入）
# PF_EMBEDDING_CLOUD_API_KEY=

# 托管 API 地址与模型（一般无需改；默认 https://api.siliconflow.cn + BAAI/bge-m3）
# PF_EMBEDDING_CLOUD_BASE_URL=https://api.siliconflow.cn
# PF_EMBEDDING_CLOUD_MODEL=BAAI/bge-m3

# ---------- PostgreSQL 会话持久化 + 用户表（SP7 起默认 jdbc，需 PG） ----------
# 代码默认 pf.chat.memory=jdbc（会话历史进库；用户注册/登录的 user_account 表也在 PG）。
# Docker Compose 默认自带 pg 服务（app 等其 healthy 后启动），以下一般无需改动。
# PF_CHAT_MEMORY=jdbc
# SPRING_DATASOURCE_URL=jdbc:postgresql://pg:5432/pf_agent
# SPRING_DATASOURCE_USERNAME=pf_agent
# SPRING_DATASOURCE_PASSWORD=pf_agent
# 纯内存模式（无 PG 环境）：PF_CHAT_MEMORY=memory（Docker 下建议同时去掉 app 的 depends_on pg）
#（Flyway 自动建表/迁移，含 user_account）

# ---------- 用户鉴权（SP7；默认关闭，开源自部署零摩擦） ----------
# 开启后 /api/chat 与 /api/chat/feedback 需 Bearer JWT（前端自动带 token）；
# 强制要求 jdbc 模式（pf.chat.memory=jdbc，启动校验 fail-fast）。
# PF_AUTH_ENABLED=false
# ⚠️ 生产开启鉴权时必须覆盖 JWT 密钥（yml 里的开发默认值仅本地跑通，泄露=任何人可伪造登录态）：
# PF_AUTH_JWT_SECRET=请换成足够长的随机字符串
# JWT 有效期（小时，默认 72）。多虚线属性 env 覆盖不可靠（见 DEPLOYMENT 坑 ①），建议 yml 或程序参数改：
# PF_AUTH_TOKEN_TTL_HOURS=72

# ---------- 按 IP 限频 / 匿名会话配额（默认关闭；托管公网部署建议开启） ----------
# 这些是多虚线属性，env 覆盖不可靠（已知坑 ①），Docker 请在 compose 的
# command 加 --pf.rate-limit.enabled=true 等程序参数，本地改 yml。
# PF_RATE_LIMIT_ENABLED=false
# PF_RATE_LIMIT_PER_MINUTE=20
# PF_QUOTA_ENABLED=false
# PF_QUOTA_ANONYMOUS_ROUNDS=20

# ---------- 服务端口（默认 8080） ----------
# SERVER_PORT=8080

# ---------- 其它可调项（默认即可，一般不用动） ----------
# Ollama 地址（Docker Compose 内默认指向内置 ollama 服务；本地默认 localhost:11434）
# SPRING_AI_OLLAMA_BASE_URL=http://localhost:11434
